# YouCam / Perfect Corp API credentials.
# Get these at https://yce.perfectcorp.com/api-console -> API Keys.
# These are SERVER-SIDE ONLY. Never prefix them with VITE_, or Vite will
# inline them into the public client bundle.
YOUCAM_API_KEY=
YOUCAM_API_SECRET=

# Optional. Adds a stylist layer on top of the measurements: the model picks six
# products per aisle from the twelve code already ranked, writes a sentence for
# each, and writes the read-back of the scan. Without it the app still
# recommends the same six, using the top colour matches, and says so.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
